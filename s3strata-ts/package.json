{
  "name": "@siwats/s3strata",
  "version": "1.6.0",
  "description": "Object storage abstraction layer with dual-bucket tiered storage and visibility control for Bun/TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "browser": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "prepublishOnly": "bun run build",
    "test:minio": "bun run src/examples/minio-test.ts"
  },
  "keywords": [
    "s3",
    "object-storage",
    "storage",
    "tiered-storage",
    "hot-cold-storage",
    "file-management",
    "multi-endpoint",
    "bun",
    "typescript"
  ],
  "author": "Siwat Sirichai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiwatINC/s3strata.git"
  },
  "peerDependencies": {
    "bun": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "latest",
    "@types/node": "^24.13.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "overrides": {
    "minimatch": ">=10.0.3",
    "brace-expansion": ">=2.0.3",
    "glob": ">=10.5.0",
    "rollup": ">=4.59.0",
    "picomatch": ">=4.0.4",
    "esbuild": ">=0.28.1"
  }
}
